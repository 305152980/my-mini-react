{
  "name": "my-mini-react",
  "version": "1.0.0",
  "type": "module",
  "description": "A mini React implementation for learning",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "lint:report": "eslint packages -f json -o eslint-report.json",
    "lint:all": "eslint packages examples project",
    "lint:fix:all": "eslint packages examples project --fix",
    "lint:report:all": "eslint packages examples project -f json -o eslint-report-all.json",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{js,ts,tsx,json,css,md}\"",
    "format:lint:fix": "pnpm run format && pnpm run lint:fix",
    "format:all": "prettier --write \"{packages,examples,project}/**/*.{js,ts,tsx,json,css,md}\"",
    "format:check:all": "prettier --check \"{packages,examples,project}/**/*.{js,ts,tsx,json,css,md}\"",
    "format:lint:fix:all": "pnpm run format:all && pnpm run lint:fix:all",
    "format:watch": "onchange \"packages/**/*.{js,ts,tsx,json,css,md}\" -- pnpm exec prettier --write {{changed}}",
    "format:watch:all": "onchange \"{packages,examples,project}/**/*.{js,ts,tsx,json,css,md}\" -- pnpm exec prettier --write {{changed}}",
    "dev:examples": "pnpm --filter examples dev",
    "dev:project": "pnpm --dir project dev",
    "test": "vitest",
    "build:all": "rimraf dist && rollup --config scripts/rollup/all.config.js && node scripts/rollup/fix-package-json.js && pnpm --dir project install --ignore-workspace && rimraf project/node_modules/.vite"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-alias": "6.0.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.4.0",
    "onchange": "7.1.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-generate-package-json": "3.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.26.1"
}
