{
  "files.eol": "\n",

  // 设置 JavaScript 和 TypeScript 的缩进为 2 个空格。
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },

  // "[javascript]": {
  //     "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  // },
  // "[typescript]": {
  //     "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  // },
  // 设置 Prettier 作为格式化工具。
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // 启用 ESLint。
  "eslint.enable": true,
  // ESLint 运行时机：onSave。（只在保存时检查，减少性能开销。）
  "eslint.run": "onSave",

  // 关闭保存时自动修复。
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  // 关闭保存时自动格式化。
  "editor.formatOnSave": false,
}
